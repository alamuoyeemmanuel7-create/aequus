# RPC endpoint used by both the web app and the CLI scripts.
# Devnet while testing, mainnet-beta (or a paid RPC) when going live.
RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Local keypair used only by the CLI scripts (create-config.ts / create-pool.ts).
KEYPAIR_PATH=~/.config/solana/id.json

# Marketplace treasury wallet that receives premium preset unlock payments.
NEXT_PUBLIC_MARKETPLACE_TREASURY=REPLACE_WITH_YOUR_TREASURY_PUBKEY
